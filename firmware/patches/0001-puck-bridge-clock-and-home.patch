+        if (down) ht_box(f, LIST_HIT_X, y + 2, LIST_HIT_W, TAB_ROW_HEIGHT - 4, 16, SEL, SEL);
+        char label[PB_TEXT], value[PB_TEXT];
+        pb_clean(label, sizeof label, pb.item[i].label[0] ? pb.item[i].label : pb.item[i].id, small);
+        pb_clean(value, sizeof value, pb.item[i].value, mid);
+        focus_put(f, LIST_HIT_X, y + 4, LIST_HIT_W, small, color(0x8a8a99), ground, label, true);
+        focus_put(f, LIST_HIT_X, y + 28, LIST_HIT_W, mid, !s.connected ? DIM : down ? ACCENT : FG, ground, value, true);
+    }
+    if (pb.count > TAB_ROWS) {   // where the window is, as the inbox's "1/2": a drag shows the rest
+        char where[32];
+        int end = s.offset + TAB_ROWS < pb.count ? s.offset + TAB_ROWS : pb.count;
+        snprintf(where, sizeof where, "%d\xe2\x80\x93%d of %d", s.offset + 1, end, pb.count);
+        focus_put(f, 40, 392, HT_WIDTH - 80, small, color(0x8a8a99), BG, where, true);
+    }
