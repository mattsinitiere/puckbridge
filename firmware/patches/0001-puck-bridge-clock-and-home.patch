+/*
+ * THE PUCK BRIDGE MENU: the rows the Mac sent in `pb.menu`, four at a time in the controls list's geometry
+ * (TAB_TOP, TAB_ROW_HEIGHT; a drag moves it a row at a time, tabs_move), each its label in grey Inter 20
+ * over its value in Inter 25. A tap reports the row's id (pb.menu.tap) and the Mac answers with the whole
+ * list again; nothing changes here until it does. The small button goes back to the clock.
+ */
+static void render_pbmenu(ht_scene_t *f)
+{
+    char title[17];
+    size_t n = 0;
+    for (const char *c = pb.title[0] ? pb.title : "Settings"; *c && n + 1 < sizeof title; c++)
+        if (*c >= 0x20 && *c < 0x7f) title[n++] = *c >= 'a' && *c <= 'z' ? (char)(*c - 'a' + 'A') : *c;
+    title[n] = 0;
+    focus_header(f, title);
+    const ht_font_t *mid = &ht_lv_inter_25.base, *small = &ht_lv_inter_20.base;
+    if (pb.count <= 0) {
+        focus_put(f, 40, 211, HT_WIDTH - 80, mid, DIM, BG,
+                  pb.count == -1 ? "Loading\xe2\x80\xa6" : pb.count == 0 ? "Nothing to set." :
+                  "No answer from the Mac.", true);
+        return;
+    }
+    int last = pb.count > TAB_ROWS ? pb.count - TAB_ROWS : 0;
+    if (s.offset > last) s.offset = last;
+    if (s.offset < 0) s.offset = 0;
+    for (int row = 0; row < TAB_ROWS && s.offset + row < pb.count && s.hit_count < 24; row++) {
+        int i = s.offset + row, y = TAB_TOP + row * TAB_ROW_HEIGHT, hit = s.hit_count++;
+        s.hits[hit] = (hit_t){{LIST_HIT_X, y, LIST_HIT_W, TAB_ROW_HEIGHT}, A_PBMENU_TAP, i, s.connected};
+        bool down = hit == s.pressed;
