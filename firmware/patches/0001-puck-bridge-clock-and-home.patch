+    pb_clean(ampm, sizeof ampm, pb.seen ? pb.ampm : "", mid);
+    bool placeholder = !time[0];
+    if (placeholder) COPY(time, "--:--");
+    int aw = ampm[0] ? ht_measure(mid, ampm) : 0, gap = aw ? 8 : 0;
+    int tw = ht_fit_width(shown, sizeof shown, time, 360 - aw - gap, big);
+    if (tw <= 0) { shown[0] = 0; tw = 1; }
