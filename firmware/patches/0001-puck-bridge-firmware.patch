+        if (secs >= 3600) snprintf(r->sub, sizeof r->sub, "Working \xc2\xb7 %u:%02u:%02u", (unsigned)(secs / 3600),
+                                   (unsigned)(secs / 60 % 60), (unsigned)(secs % 60));
+        else snprintf(r->sub, sizeof r->sub, "Working \xc2\xb7 %u:%02u", (unsigned)(secs / 60), (unsigned)(secs % 60));
