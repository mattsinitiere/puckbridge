+static void pb_row(int i, bool tabs, pb_row_t *r)
+{
+    memset(r, 0, sizeof *r);
+    r->sub_ink = 0x8a8a99;
+    if (tabs) {
+        const cable_swarm_t *t = &s.tabs[i];
+        snprintf(r->name, sizeof r->name, "%s", t->name[0] ? t->name : "Untitled");
+        r->current = !strcmp(t->id, s.selected_tab);
+        int panes = r->current ? s.count : t->panes;
+        int working = r->current ? pb_tab_working(i) : t->working >= 0 ? t->working : pb_tab_working(i);
+        bool code = !strncmp(t->id, "code", 4);
+        snprintf(r->sub, sizeof r->sub, "%d %s", panes, code ? (panes == 1 ? "session" : "sessions") :
+                 (panes == 1 ? "chat" : "chats"));
+        bool opening = workspace.phase != HT_WORKSPACE_IDLE && !strcmp(workspace.pending, t->id);
+        if (opening) { snprintf(r->extra, sizeof r->extra, "  \xc2\xb7  Opening\xe2\x80\xa6"); r->extra_ink = HT_THEME_VOICE; }
+        else if (working > 0) { snprintf(r->extra, sizeof r->extra, "  \xc2\xb7  %d working", working); r->extra_ink = PB_INK_BUSY; }
+        r->dot = working > 0 ? PB_INK_BUSY : 0;
+        return;
+    }
+    const agent_t *a = &s.agents[i];
+    snprintf(r->name, sizeof r->name, "%s", pane_label(i));
+    r->current = i == s.active;
