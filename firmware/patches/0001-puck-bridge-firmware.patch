+/*
+ * THE HOST'S WORDS, CUT TO WHAT THE FACE CAN DRAW (Puck Bridge). Every letter the face (or its fallback)
+ * has no glyph for is dropped rather than drawn as a box — a "°" is in every Inter face here, an emoji is
+ * not — as are control bytes and the spaces at either end; the copy keeps whole UTF-8 letters in `cap`.
+ */
+static bool pb_has_glyph(const ht_pfont_t *face, uint32_t cp)
+{
+    for (; face; face = face->fallback) {
+        int lo = 0, hi = face->count - 1;
+        while (lo <= hi) {
+            int mid = (lo + hi) / 2;
+            if (face->codes[mid] == cp) return true;
+            if (face->codes[mid] < cp) lo = mid + 1; else hi = mid - 1;
+        }
+    }
+    return false;
+}
+static void pb_clean(char *dst, size_t cap, const char *src, const ht_font_t *font)
+{
+    if (!cap) return;
+    const ht_pfont_t *face = ht_pfont(font);
+    size_t used = 0;
+    for (const char *p = src ? src : ""; *p;) {
+        const char *start = p;
+        uint32_t cp = ht_utf8_next(&p);
+        size_t n = (size_t)(p - start);
+        bool drawn = (cp == ' ' && used) || (cp > 0x20 && (face ? pb_has_glyph(face, cp) : cp < 0x7f));
+        if (!drawn) continue;
+        if (used + n >= cap) break;
+        memcpy(dst + used, start, n);
+        used += n;
+    }
+    while (used && dst[used - 1] == ' ') used--;   // what was dropped must not leave the line off-centre
+    dst[used] = 0;
+}
+/*
+ * PUCK BRIDGE'S PAGES, side by side (owner's design B3): [settings] <- [clock] -> [pane 1] -> [pane 2] -> ...
+ * The dots under the clock and the settings list say where you are: settings, the clock, then one per pane of the
+ * tab (five at most, a "+" after them for more). The page on screen is the bright, larger dot.
+ */
+enum { PB_PAGE_SETTINGS = 0, PB_PAGE_CLOCK = 1, PB_DOTS_PANES = 5 };
+#define PB_INK_DOT_ON 0xeaeaf0u
+#define PB_INK_DOT 0x4c4c55u
+static void pb_dots(ht_scene_t *f, int page, int cx, int y)
+{
+    if (pb_nav()) return;   // pb 5: no row of side pages any more (the clock is a crossroads, not a page)
+    int panes = s.count < PB_DOTS_PANES ? s.count : PB_DOTS_PANES, n = 2 + panes;
+    bool more = s.count > PB_DOTS_PANES;
+    enum { PITCH = 16, ON = 8, OFF = 6 };
+    int x = cx - ((n - 1) * PITCH + (more ? 12 : 0)) / 2;
+    for (int i = 0; i < n; i++, x += PITCH) {
+        bool on = i == page || (page >= 2 + PB_DOTS_PANES && i == n - 1);
+        int d = on ? ON : OFF;
+        ht_box(f, x - d / 2, y - d / 2, d, d, d / 2, color(on ? PB_INK_DOT_ON : PB_INK_DOT),
+               color(on ? PB_INK_DOT_ON : PB_INK_DOT));
+    }
+    if (more) {
+        const ht_font_t *small = &ht_lv_inter_20.base;
+        int w = ht_measure(small, "+");
+        ht_text(f, x - PITCH + 8, y - ht_pfont(small)->ascent + 7, w, small, color(PB_INK_DOT), BG, "+");
+    }
+}
+/*
+ * THE CLOCK (owner's design A3, "big time with status ring"): Puck Bridge's home — the small button's, idle's
+ * (pb_tick) and the page left of the first pane. On the black glass: the date small and letter-spaced in capitals
+ * (pb_caps), the time large in tabular Inter SemiBold (pb_time, digits only) with am/pm beside it on its baseline,
+ * the weather under it, the pane's pet standing still, and the page dots. Around the edge a ring, a segment per
+ * pane of the tab (12 at most) clockwise from 12 o'clock: orange while it works, white when it finished and its
+ * notice is unread, dim when idle; no panes is one whole dim ring. Before any `ambient` the time is a dim "--:--"
+ * and nothing else is written. Every word is the host's; nothing here knows what time it is. Against AMOLED
+ * burn-in the words, the pet and the dots move round a small orbit and the ring turns a degree, each `ambient`.
+ */
+enum { CLOCK_DATE_Y = 117, CLOCK_TIME_Y = 146, CLOCK_WEATHER_Y = 254, CLOCK_PET_FOOT = 354, CLOCK_DOTS_Y = 394,
+       CLOCK_RING_R = 223, CLOCK_RING_W = 6, CLOCK_RING_GAP = 4, CLOCK_RING_MAX = 12 };
+static uint16_t pb_ring_ink(const agent_t *a)
+{
+    if (a->busy) return color(PB_INK_BUSY);
+    for (int i = 0; i < s.notice_count; i++)
+        if (!s.notice[i].read_on_dial && !strcmp(s.notice[i].agent_id, a->id)) return color(PB_INK_UNREAD);
+    return color(PB_INK_IDLE);
+}
+static void clock_ring(ht_scene_t *f, int turn)
+{
+    const int c16 = HT_WIDTH * 8, r16 = CLOCK_RING_R * 16, w16 = CLOCK_RING_W * 16;
+    int n = s.count < CLOCK_RING_MAX ? s.count : CLOCK_RING_MAX;
+    if (!n) { ht_ring_arc(f, c16, c16, r16, w16, 90, 180, color(PB_INK_IDLE)); return; }
+    for (int i = 0; i < n; i++) {
+        // Segment i spans [i, i + 1) of n slots clockwise from the top; ht_ring_arc counts anticlockwise from 3.
+        int from = i * 360 / n, to = (i + 1) * 360 / n, half = (to - from - CLOCK_RING_GAP) / 2;
+        int mid = 90 - (from + to) / 2 + turn;
+        ht_ring_arc(f, c16, c16, r16, w16, (mid % 360 + 360) % 360, half < 1 ? 1 : half, pb_ring_ink(&s.agents[i]));
+    }
+}
+// The host's date in the caps face: ASCII letters upper-cased, the first ", " a spaced middle dot. A letter the
+// face lacks is Inter 20's (its fallback).
+static void clock_date(char *dst, size_t cap, const char *src)
+{
+    char up[sizeof pb.date + 8];
+    size_t n = 0;
+    bool dotted = false;
+    for (const char *c = src ? src : ""; *c && n + 5 < sizeof up; c++) {
+        if (!dotted && c[0] == ',' && c[1] == ' ') {
+            memcpy(up + n, " \xc2\xb7 ", 4); n += 4; c++; dotted = true;
+            continue;
+        }
+        // Latin-1's small letters (U+00E0..U+00FE but the division sign) are their capitals 0x20 below.
+        if ((unsigned char)c[0] == 0xc3 && (unsigned char)c[1] >= 0xa0 && (unsigned char)c[1] <= 0xbe &&
+            (unsigned char)c[1] != 0xb7) {
+            up[n++] = c[0]; up[n++] = (char)((unsigned char)c[1] - 0x20); c++;
+            continue;
+        }
+        up[n++] = *c >= 'a' && *c <= 'z' ? (char)(*c - 'a' + 'A') : *c;
+    }
+    up[n] = 0;
+    pb_clean(dst, cap, up, &ht_lv_pb_caps.base);
+}
+static void render_clock(ht_scene_t *f)
+{
+    static const int8_t orbit[8][2] = {{0, 0}, {2, 0}, {2, 2}, {0, 2}, {-2, 2}, {-2, 0}, {-2, -2}, {0, -2}};
+    const ht_font_t *big = &ht_lv_pb_time.base, *caps = &ht_lv_pb_caps.base, *mid = &ht_lv_inter_25.base,
+                    *small = &ht_lv_inter_20.base;
+    int dx = orbit[pb.shift % 8][0], dy = orbit[pb.shift % 8][1];
+    clock_ring(f, (int)(pb.shift % 5) - 2);
+    char time[sizeof pb.time], ampm[sizeof pb.ampm], shown[HT_TEXT_BYTES], line[HT_TEXT_BYTES];
+    clock_date(line, sizeof line, pb.seen ? pb.date : "");
+    focus_put(f, 40 + dx, CLOCK_DATE_Y + dy, HT_WIDTH - 80, caps, color(0x8a8a99), BG, line, true);
+    pb_clean(time, sizeof time, pb.seen ? pb.time : "", big);
+    pb_clean(ampm, sizeof ampm, pb.seen ? pb.ampm : "", small);
+    bool placeholder = !time[0];
+    if (placeholder) COPY(time, "--:--");
+    const ht_font_t *face = big;
+    int aw = ampm[0] ? ht_measure(small, ampm) : 0, gap = aw ? 6 : 0;
+    int tw = ht_fit_width(shown, sizeof shown, time, 392 - aw - gap, face);
+    if (tw <= 0) { shown[0] = 0; tw = 1; }
+    int x = (HT_WIDTH - (tw + gap + aw)) / 2 + dx;
+    int y = CLOCK_TIME_Y + dy;
+    ht_text(f, x, y, tw, face, color(placeholder ? 0x4c4c4c : 0xf4f4f6), BG, shown);
+    int base = y + ht_pfont(face)->ascent;
+    ht_text(f, x + tw + gap, base - ht_pfont(small)->ascent, aw ? aw : 1, small, color(0x8a8a99), BG, ampm);
+    char weather[sizeof pb.temp + sizeof pb.cond + 2] = "";
+    if (pb.seen)
+        snprintf(weather, sizeof weather, "%s%s%s", pb.temp, pb.temp[0] && pb.cond[0] ? "  " : "", pb.cond);
