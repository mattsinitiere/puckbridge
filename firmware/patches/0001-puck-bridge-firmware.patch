+    char where[40];
+    snprintf(where, sizeof where, "%s  \xc2\xb7  %d of %d", tabs && pick == A_TAB ? "Tap to switch" : "Tap to open",
+             current + 1, count);
+    focus_centred(f, 362, 260, hint, color(0x585863), BG, where);
+    s.hits[s.hit_count++] = (hit_t){{40, 100, 386, 300}, pick, map ? map[current] : current, s.connected};
+}
