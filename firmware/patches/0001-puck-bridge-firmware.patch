+}
+/*
+ * THE TIMER'S ALARM (pb 3): "Time's up" over the timer's label, a big orange 0:00, the ring blinking orange once a
+ * second, and a Stop pill — though any touch, anywhere, stops it, as the small button does.
+ */
+static void render_timer(ht_scene_t *f)
+{
+    const int c16 = HT_WIDTH * 8;
+    bool lit = (ms() - pbt.ring_started) / 1000 % 2 == 0;
+    ht_ring_arc(f, c16, c16, CLOCK_RING_R * 16, CLOCK_RING_W * 16, 90, 180, color(lit ? PB_INK_BUSY : PB_INK_IDLE));
+    focus_header(f, pbt.alarm ? "ALARM" : "TIMER");
+    const ht_font_t *big = &ht_lv_inter_44.base, *mid = &ht_lv_inter_25.base, *digits = &ht_lv_pb_time.base;
+    focus_put(f, 40, 92, HT_WIDTH - 80, big, FG, BG, pbt.alarm ? "Alarm" : "Time's up", true);
+    char label[PB_TEXT], big_text[24];
+    pb_clean(label, sizeof label, pbt.ring_label, mid);
+    focus_put(f, 40, 148, HT_WIDTH - 80, mid, DIM, BG, label, true);
+    // An alarm shows the time it is (the Mac's clock string, pb.time); the timer its 0:00.
+    pb_clean(big_text, sizeof big_text, pbt.alarm && pb.seen && pb.time[0] ? pb.time : "0:00", digits);
+    int w = ht_measure(digits, big_text);
+    if (w > HT_WIDTH - 80) w = HT_WIDTH - 80;
+    ht_text(f, (HT_WIDTH - w) / 2, 194, w, digits, color(PB_INK_BUSY), BG, big_text);
+    enum { X = 143, Y = 318, W = 180, H = 56 };
+    const ht_font_t *pf = &ht_lv_inter_28.base;
+    int sw = ht_measure(pf, "Stop");
+    ht_box(f, X, Y, W, H, H / 2, color(0x171718), color(0x3a3f4b));
+    ht_text(f, (HT_WIDTH - sw) / 2, Y + (H - pf->height) / 2, sw, pf, color(PB_INK_BUSY), color(0x171718), "Stop");
+}
+/*
+ * THE TIMER DIAL (pb 6): hours, minutes and seconds in three columns, each a "+" over its value over its unit over a
+ * "-"; a drag up or down a column turns it too (a step every PB_DIAL_STEP px). Start sets the timer and goes to the
+ * clock; with a timer running, its time left heads the page and Stop cancels it. A swipe right (or the small button)
+ * goes back to the clock. Opened by a tap on the clock's timer line, a long press nowhere: it is a page, not a mode.
+ */
+enum { PB_DIAL_STEP = 22, PB_DIAL_PLUS_Y = 122, PB_DIAL_VALUE_Y = 184, PB_DIAL_UNIT_Y = 240, PB_DIAL_MINUS_Y = 270,
+       PB_DIAL_BOX = 52, PB_DIAL_PILL_Y = 344 };
+static const int pb_dial_x[3] = {128, 233, 338};
+static int pb_dial_column(int x) { return x < 180 ? 0 : x < 286 ? 1 : 2; }
+static void pb_dial_turn(int column, int by)
+{
+    int *v = column == 0 ? &pb.set_h : column == 1 ? &pb.set_m : &pb.set_s;
+    int top = column == 0 ? 24 : 60;
+    *v = ((*v + by) % top + top) % top;
+}
+static void render_timerset(ht_scene_t *f)
+{
+    focus_header(f, "TIMER");
+    const ht_font_t *big = &ht_lv_inter_44.base, *mid = &ht_lv_inter_25.base, *small = &ht_lv_inter_20.base;
+    if (pbt.running) {
+        char left[16], line[40];
+        pb_timer_text(left, sizeof left, pb_timer_left());
+        snprintf(line, sizeof line, "%s left", left);
+        focus_put(f, 40, 92, HT_WIDTH - 80, small, color(PB_INK_BUSY), BG, line, true);
+    }
+    const int value[3] = {pb.set_h, pb.set_m, pb.set_s};
+    static const char *const unit[3] = {"hours", "min", "sec"};
+    uint16_t box = color(0x171718), edge = color(0x3a3f4b), ink = FG;
+    for (int c = 0; c < 3; c++) {
+        int cx = pb_dial_x[c];
+        for (int up = 1; up >= 0; up--) {
+            int y = up ? PB_DIAL_PLUS_Y : PB_DIAL_MINUS_Y, hit = s.hit_count;
+            if (hit < 24) s.hits[s.hit_count++] = (hit_t){{cx - 48, y - 8, 96, PB_DIAL_BOX + 16}, A_PB_SET_ADJ,
+                                                           c * 2 + up, true};
+            uint16_t fill = hit == s.pressed ? color(0x30333f) : box;
+            ht_box(f, cx - 36, y, 72, PB_DIAL_BOX, 14, fill, edge);
+            // "+" and "-" drawn, not set: Inter's minus sits low and its plus is thin at this size
+            ht_box(f, cx - 12, y + PB_DIAL_BOX / 2 - 2, 24, 4, 2, ink, ink);
+            if (up) ht_box(f, cx - 2, y + PB_DIAL_BOX / 2 - 12, 4, 24, 2, ink, ink);
+        }
+        char text[4];
+        snprintf(text, sizeof text, "%02d", value[c] < 0 ? 0 : value[c] > 99 ? 99 : value[c]);
+        int w = ht_measure(big, text);
+        ht_text(f, cx - w / 2, PB_DIAL_VALUE_Y, w, big, FG, BG, text);
+        w = ht_measure(small, unit[c]);
+        ht_text(f, cx - w / 2, PB_DIAL_UNIT_Y, w, small, DIM, BG, unit[c]);
+        if (c < 2) {
+            int cw = ht_measure(big, ":");
+            ht_text(f, (cx + pb_dial_x[c + 1]) / 2 - cw / 2, PB_DIAL_VALUE_Y - 2, cw, big, DIM, BG, ":");
+        }
+    }
+    bool any = pb.set_h || pb.set_m || pb.set_s;
+    if (pbt.running) {
+        pb_pill(f, 73, PB_DIAL_PILL_Y, 150, "Stop", color(PB_INK_BUSY), A_PB_SET_STOP, true);
+        pb_pill(f, 243, PB_DIAL_PILL_Y, 150, "Start", color(HT_THEME_VOICE), A_PB_SET_GO, any);
+    } else pb_pill(f, 143, PB_DIAL_PILL_Y, 180, "Start", color(HT_THEME_VOICE), A_PB_SET_GO, any);
+    (void)mid;
+}
+/*
+ * THE PICKER (owner's design C4, the pages): one row's choices paged sideways — its label as the header, the choice
+ * on the page large in the middle (its pet, animated, over its name; a choice with no pet its name alone, large), the
+ * neighbours small at the sides, the dots under them, and [ Choose ] at the foot. The current value is green. A swipe
+ * or a tap on a neighbour pages; Choose sends `pb.menu.set` and goes back to the list; "<" and the small button go
+ * back without choosing.
+ */
+enum { PICK_MID_Y = 214, PICK_PET_FOOT = 252, PICK_SIDE_X = 150, PICK_DOTS_Y = 326, PICK_BUTTON_X = 143,
+       PICK_BUTTON_Y = 352, PICK_BUTTON_W = 180, PICK_BUTTON_H = 56 };
+static void render_picker(ht_scene_t *f)
+{
+    const ht_font_t *big = &ht_lv_inter_44.base, *mid = &ht_lv_inter_30.base, *small = &ht_lv_inter_20.base;
+    int row = pb.pick_row, count = row >= 0 && row < pb.count ? pb.item[row].choices : 0;
+    pb.pet_next = 0;
+    char title[17], text[HT_TEXT_BYTES];
+    size_t n = 0;
+    for (const char *c = count ? (pb.item[row].label[0] ? pb.item[row].label : pb.item[row].id) : "";
+         *c && n + 1 < sizeof title; c++)
+        if (*c >= 0x20 && *c < 0x7f) title[n++] = *c >= 'a' && *c <= 'z' ? (char)(*c - 'a' + 'A') : *c;
+    title[n] = 0;
+    focus_header(f, title);
+    // "<": the way back without choosing, top left inside the glass.
+    int back = s.hit_count++;
+    s.hits[back] = (hit_t){{56, 34, 92, 76}, A_PB_BACK, 0, true};
+    ht_text(f, 92, 52, ht_measure(mid, "<"), mid, back == s.pressed ? ACCENT : color(0x8a8a99), BG, "<");
+    if (!count) return;
+    if (pb.pick >= count) pb.pick = count - 1;
+    if (pb.pick < 0) pb.pick = 0;
+    uint32_t clock = (s.quiet || display_is_asleep()) ? 0 : ms() | 1;
+    for (int side = -1; side <= 1; side++) {
+        int i = pb.pick + side;
+        if (i < 0 || i >= count) continue;
+        const char *value = pb_choice[row][i].value, *pet = pb_choice[row][i].pet;
+        bool here = !side, current = i == pb.item[row].index;
+        int cx = HT_WIDTH / 2 + side * PICK_SIDE_X;
+        uint16_t ink = !s.connected ? DIM : current ? color(HT_THEME_VOICE) : here ? FG : color(0x6a6962);
+        uint32_t next = 0;
+        bool drawn = pet[0] && ht_focus_pet_preview(f, pet, pb_choice[row][i].builtin, cx, here ? PICK_PET_FOOT :
+                                                    PICK_PET_FOOT - 24, here ? 8 : 4, here ? clock : 0, &next);
+        if (here) pb.pet_next = next;
+        const ht_font_t *font = drawn ? (here ? mid : small) : (here ? big : &ht_lv_inter_25.base);
+        pb_clean(text, sizeof text, value, font);
+        int room = here ? 300 : 120, tw = ht_fit_width(text, sizeof text, text, room, font);
+        if (tw <= 0) { text[0] = 0; tw = 1; }
+        int y = drawn ? PICK_PET_FOOT + (here ? 14 : -14) : PICK_MID_Y - font->height / 2;
+        int x = cx - tw / 2;
+        if (x < 30) x = 30;
+        if (x + tw > HT_WIDTH - 30) x = HT_WIDTH - 30 - tw;
+        ht_text(f, x, y, tw, font, ink, BG, text);
+        // A neighbour's half of the glass pages to it; the page in the middle has nothing to tap.
+        if (side) s.hits[s.hit_count++] = (hit_t){{side < 0 ? 20 : 313, 110, 133, 200}, A_PB_PICK, i, true};
+    }
+    // Where this page is among the choices.
+    enum { PITCH = 14 };
+    int x = HT_WIDTH / 2 - (count - 1) * PITCH / 2;
+    for (int i = 0; i < count; i++, x += PITCH) {
+        int d = i == pb.pick ? 8 : 6;
+        uint16_t ink = color(i == pb.pick ? PB_INK_DOT_ON : PB_INK_DOT);
+        ht_box(f, x - d / 2, PICK_DOTS_Y - d / 2, d, d, d / 2, ink, ink);
+    }
+    int choose = s.hit_count++;
+    s.hits[choose] = (hit_t){{PICK_BUTTON_X - 20, PICK_BUTTON_Y - 10, PICK_BUTTON_W + 40, PICK_BUTTON_H + 24},
+                             A_PB_CHOOSE, pb.pick, s.connected};
+    uint16_t pill = choose == s.pressed ? color(0x30333f) : color(0x171718);
+    const ht_font_t *pf = &ht_lv_inter_28.base;
+    int cw = ht_measure(pf, "Choose");
+    ht_box(f, PICK_BUTTON_X, PICK_BUTTON_Y, PICK_BUTTON_W, PICK_BUTTON_H, PICK_BUTTON_H / 2, pill, color(0x3a3f4b));
+    ht_text(f, (HT_WIDTH - cw) / 2, PICK_BUTTON_Y + (PICK_BUTTON_H - pf->height) / 2, cw, pf,
+            s.connected ? color(HT_THEME_VOICE) : DIM, pill, "Choose");
+}
