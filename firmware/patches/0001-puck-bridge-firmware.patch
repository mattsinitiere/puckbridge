+        pb_clean(label, sizeof label, pbt.label[0] ? pbt.label : "Timer", mid);
+        snprintf(line, sizeof line, "%s  %s", label, left);
+        under = color(PB_INK_BUSY);
+    }
+    focus_put(f, 40 + dx, CLOCK_WEATHER_Y + dy, HT_WIDTH - 80, mid, under, BG, line, true);
+    // The pet of the pane on the face (else the first pane): every pane wears the engine Puck Bridge was told.
+    const agent_t *a = active() ? active() : s.count ? &s.agents[0] : NULL;
+    if (a && a->engine[0]) ht_focus_still_pet(f, a->engine, HT_WIDTH / 2 + dx, CLOCK_PET_FOOT + dy);
