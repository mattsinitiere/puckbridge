diff --git a/devices/harness-device/firmware/scripts/gen_pb_faces.py b/devices/harness-device/firmware/scripts/gen_pb_faces.py
new file mode 100644
index 0000000..b118616
--- /dev/null
+++ b/devices/harness-device/firmware/scripts/gen_pb_faces.py
@@ -0,0 +1,111 @@
+"""Puck Bridge's clock faces, converted with lv_font_conv exactly as gen_focus_faces.py converts Focus's.
+
+    python3 devices/harness-device/firmware/scripts/gen_pb_faces.py [--instance path/to/Inter[opsz,wght].ttf]
+
+Writes main/ui/habitat/pb_faces.c and pb_faces.h. Two faces, each cut to the few letters the clock draws:
+
+  pb_time  the big time: Inter SemiBold (opsz 32, wght 600) at TIME_PX, the digits 0-9, ':', '-' and the space only,
+           with the TABULAR figures (Inter's tnum alternates mapped in place of the default digits), so a minute
+           that ticks over does not move the time sideways.
+  pb_caps  the date line above it: Inter Medium (opsz 14, wght 550) at CAPS_PX, A-Z, Latin-1's capitals, 0-9,
+           the space, ',', '.', the middle dot and the hyphen; TRACKING px are added to every advance, so a whole letter-spaced line is
+           one run (the scene holds 40). Any other letter comes from Inter 20 (its fallback).
+
+Inter (OFL 1.1, fonts/Inter-OFL.txt). The two cut-down instances are vendored as fonts/Inter-PbTime.ttf and
+fonts/Inter-PbCaps.ttf; `--instance` re-cuts them from the variable Inter[opsz,wght].ttf (github.com/google/fonts
+ofl/inter), which needs fontTools. The default run reads the vendored files and needs node (npx lv_font_conv).
+"""
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import gen_lvgl_assets as base   # noqa: E402
+
+root = base.root
+LV_FONT_CONV = 'lv_font_conv@1.5.2'
+FONTS = root / 'fonts'
+TIME_PX = 112
+CAPS_PX = 18
+TRACKING = 2          # px added to each pb_caps advance
+TIME = {ord(c) for c in '0123456789:- '}   # '-' for the "--:--" before the first ambient
+# Latin-1's capitals too (U+00C0..U+00DE but the multiplication sign): the host's date may be in Spanish or
+# French, and their accents must fit the face's line, which lv_font_conv measures from the letters it is given.
+CAPS = {ord(c) for c in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 ,.-'} | {0xB7} | (set(range(0xC0, 0xDF)) - {0xD7})
+# stem -> (opsz, wght, codepoints, tabular figures)
+CUTS = {'Inter-PbTime': (32, 600, TIME, True), 'Inter-PbCaps': (14, 550, CAPS, False)}
+
+
+def instance(variable):
+    from fontTools import subset
+    from fontTools.ttLib import TTFont
+    from fontTools.varLib import instancer
+    for stem, (opsz, wght, keep, tabular) in CUTS.items():
+        font = instancer.instantiateVariableFont(TTFont(variable), {'opsz': opsz, 'wght': wght})
+        if tabular:   # the tnum feature's single substitutions, applied to the cmap itself
+            gsub = font['GSUB'].table
+            lookups = {i for fr in gsub.FeatureList.FeatureRecord if fr.FeatureTag == 'tnum'
+                       for i in fr.Feature.LookupListIndex}
+            swap = {}
+            for i in sorted(lookups):
+                for sub in gsub.LookupList.Lookup[i].SubTable:
+                    sub = getattr(sub, 'ExtSubTable', sub)
+                    swap.update(getattr(sub, 'mapping', {}) or {})
+            for table in font['cmap'].tables:
+                for cp in list(table.cmap):
+                    if chr(cp).isdigit() and table.cmap[cp] in swap:
+                        table.cmap[cp] = swap[table.cmap[cp]]
+        options = subset.Options()
+        options.layout_features, options.name_IDs, options.notdef_outline = ['kern'], ['*'], True
+        subsetter = subset.Subsetter(options)
+        subsetter.populate(unicodes=sorted(keep))
+        subsetter.subset(font)
+        font.save(FONTS / f'{stem}.ttf')
+
+
+def convert(stem, px, keep, tmp, name):
+    out = tmp / f'{name}.c'
+    subprocess.run(['npx', '-y', LV_FONT_CONV, '--size', str(px), '--bpp', '4', '--format', 'lvgl',
+                    '--no-compress', '--no-prefilter', '--force-fast-kern-format',
+                    '--font', str(FONTS / f'{stem}.ttf'), '-r', ','.join(f'0x{c:X}' for c in sorted(keep)),
+                    '--lv-include', 'lvgl.h', '-o', str(out)], check=True, capture_output=True, text=True)
+    return out.read_text()
+
+
+def main():
+    if '--instance' in sys.argv:
+        instance(sys.argv[sys.argv.index('--instance') + 1])
+    c = ['// Generated by scripts/gen_pb_faces.py. Do not edit.\n'
+         f'// Inter (OFL 1.1) through {LV_FONT_CONV}: --bpp 4 --no-compress --no-prefilter.\n'
+         '#include "terminal.h"\n#include "focus_faces.h"\n']
+    h = ['// Generated by scripts/gen_pb_faces.py. Do not edit.\n#pragma once\n#include "terminal.h"\n']
+    total = 0
+    with tempfile.TemporaryDirectory() as t:
+        # pb_caps falls back to Inter 20 (focus_faces.c) for a letter it lacks: a date in another language keeps
+        # its accented capitals, unspaced.
+        for name, stem, px, keep, track, fallback in [('pb_time', 'Inter-PbTime', TIME_PX, TIME, 0, 'NULL'),
+                                                      ('pb_caps', 'Inter-PbCaps', CAPS_PX, CAPS, TRACKING,
+                                                       '&ht_lv_inter_20')]:
+            src = convert(stem, px, keep, Path(t), name)
+            if 'right_class_cnt' not in src:   # tabular digits have no kerning: lv_font_conv writes no kern table
+                src += '\n.right_class_cnt = 0\n'
+            font = base.lv_font(src)
+            font['kern'] = font['kern'] or [0]   # a C array needs one element; no class indexes it
+            if track:   # letter-spacing baked into the advances (1/16 px), so one run draws a spaced line
+                font['dsc'] = [(i, adv + track * 16, *rest) for (i, adv, *rest) in font['dsc']]
+            code, size = base.emit_font(name, font, keep, fallback)
+            c.append(code)
+            h.append(f'extern const ht_pfont_t ht_lv_{name};\n')
+            m = re.search(rf'static const uint16_t {name}_codes\[\] = \{{(.*?)\}};', code)
+            assert {int(v) for v in m.group(1).split(',')} == keep, name
+            total += size
+            print(f'{name}: {len(keep)} glyphs, line {font["line"]}, ascent {font["line"] - font["base"]}, {size} bytes')
+    (root / 'main/ui/habitat/pb_faces.c').write_text(''.join(c))
+    (root / 'main/ui/habitat/pb_faces.h').write_text(''.join(h))
+    print(f'total {total} bytes')
+
+
+if __name__ == '__main__':
+    main()
