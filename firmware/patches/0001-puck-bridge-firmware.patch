+/*
+ * THE TIMER'S CLOCKWORK (pb 3). Its reports to the Mac are background traffic, queued as the read receipts are:
+ * never into the last slot, never a "cable busy" screen — a report that does not fit goes with the next tick.
+ */
+static bool pb_queue_quiet(action_t a)
+{
+    return actions && uxQueueSpacesAvailable(actions) > 1 && xQueueSend(actions, &a, 0) == pdPASS;
+}
+// whole seconds to go, rounded up; 0 when none runs
+static int pb_timer_left(void)
+{
+    if (!pbt.running) return 0;
+    int64_t left = pbt.end_us - esp_timer_get_time();
+    return left <= 0 ? 0 : (int)((left + 999999) / 1000000);
+}
+static void pb_timer_report(int seconds)
+{
+    if (pb_queue_quiet((action_t){.kind = A_PB_TIMER_STATE, .value = seconds})) pbt.reported = ms();
+}
+// pb 6: one alarm told to the Mac — its seconds to go, 0 once it rang or was cleared.
+static int pb_alarm_left(int k)
+{
+    if (!pba[k].on) return 0;
+    int64_t left = pba[k].at_us - esp_timer_get_time();
+    return left <= 0 ? 0 : (int)((left + 999999) / 1000000);
+}
+static void pb_alarm_report(int k)
+{
+    action_t a = {.kind = A_PB_ALARM_STATE, .value = pb_alarm_left(k)};
+    COPY(a.id, pba[k].id);
+    COPY(a.text, pba[k].label);
+    pb_queue_quiet(a);
+}
+// The timer set (seconds > 0) or cancelled (0), from the Mac or the dial; either silences an alarm without a report.
+static void pb_timer_set(int seconds, const char *label)
+{
+    pb_timer_silence("replaced", false);
+    pbt.running = seconds > 0;
+    if (pbt.running) {
+        pbt.end_us = esp_timer_get_time() + (int64_t)seconds * 1000000;
+        PB_COPY(pbt.label, label ? label : "");
+    }
+    pbt.shown = -1;
+    ESP_LOGI("habitat", "timer %s %d s", pbt.running ? "set" : "cancelled", seconds);
+    pb_timer_report(pbt.running ? seconds : 0);
+    change();
+}
+// "4:59", "1:04:59"
+static void pb_timer_text(char *dst, size_t cap, int seconds)
+{
+    if (seconds >= 3600) snprintf(dst, cap, "%d:%02d:%02d", seconds / 3600, seconds / 60 % 60, seconds % 60);
+    else snprintf(dst, cap, "%d:%02d", seconds / 60, seconds % 60);
+}
+// The alarm, silenced: a person stopped it ("stopped") or it rang out ("timeout"); `report` tells the Mac.
+static void pb_timer_silence(const char *reason, bool report)
+{
+    if (!pbt.ringing) return;
+    pbt.ringing = false;
+    ESP_LOGI("habitat", "timer alarm %s", reason);
+    if (report && !pbt.alarm) {   // an alarm's end is its pb.alarm.state 0, sent when it rang
+        action_t a = {.kind = A_PB_TIMER_DONE};
+        COPY(a.text, reason);
+        pb_queue_quiet(a);
+    }
+    if (s.view == TIMER) view(pbt.back == HOME || pbt.back == AGENT || pbt.back == CLOCK ? pbt.back : CLOCK);
+}
+static void pb_timer_tick(uint32_t now)
+{
+    // pb 6: an alarm that came due rings the same screen, unless something rings already (it waits its turn).
+    for (int i = 0; i < PB_ALARMS && !pbt.ringing; i++)
+        if (pba[i].on && esp_timer_get_time() >= pba[i].at_us) {
+            ESP_LOGI("habitat", "alarm %s: time's up", pba[i].id);
+            pba[i].on = false;
+            pbt.ringing = pbt.alarm = true;
+            PB_COPY(pbt.ring_label, pba[i].label);
+            pbt.ring_started = pbt.next_ring = now;
+            pbt.back = s.view;
+            pb_alarm_report(i);
+            if (display_is_asleep()) display_wake();
+        }
+    if (pbt.running && !pbt.ringing) {
+        int left = pb_timer_left();
+        if (left != pbt.shown) {
+            pbt.shown = left;
+            if (s.view == CLOCK || (s.view == HOME && (!s.connected || s.loading))) change();
+        }
+        if (left && now - pbt.reported >= PB_REPORT_MS) pb_timer_report(left);
+        if (!left) {
+            ESP_LOGI("habitat", "timer: time's up");
+            pbt.running = pbt.alarm = false;
+            pbt.ringing = true;
+            PB_COPY(pbt.ring_label, pbt.label);
+            pbt.ring_started = pbt.next_ring = now;
+            pbt.back = s.view;
+            pb_timer_report(0);
+            if (display_is_asleep()) display_wake();
+        }
+    }
+    if (!pbt.ringing) return;
+    // view() refuses over a live microphone, a form or a draft: the alarm screen waits for it, the minute does not.
+    if (s.view != TIMER) view(TIMER);
+    display_bump_activity();
+    if ((int32_t)(now - pbt.next_ring) >= 0) {
+        audio_notify_done();   // the chosen sound at its volume; muted is silent, and never over the microphone
+        pbt.next_ring = now + PB_RING_EVERY_MS;
+    }
+    unsigned phase = (now - pbt.ring_started) / 1000 % 2;
+    if ((int)phase != pbt.shown) { pbt.shown = (int)phase; change(); }   // the ring blinks once a second
+    if (now - pbt.ring_started >= PB_RING_FOR_MS) pb_timer_silence("timeout", true);
+}
+// A picker's sound: played once it has rested PB_PREVIEW_MS on the choice, not under a moving finger or the mic.
+static void pb_preview_tick(uint32_t now)
+{
+    if (s.view != PICKER) pb.preview_due = false;
+    if (!pb.preview_due || s.touch_down || now - pb.pick_at < PB_PREVIEW_MS) return;
+    pb.preview_due = false;
+    int row = pb.pick_row;
+    if (row < 0 || row >= pb.count || pb.pick < 0 || pb.pick >= pb.item[row].choices || s.voice_open ||
+        audio_client_active()) return;
+    ESP_LOGI("habitat", "picker preview: %s", pb_choice[row][pb.pick].value);
+    audio_notify_preview_sound(pb_choice[row][pb.pick].sound[0] ? pb_choice[row][pb.pick].sound : NULL,
+                               pb_choice[row][pb.pick].volume);
+}
+/*
+ * IDLE BECOMES THE CLOCK (Puck Bridge). Once an `ambient` has come on this connection, `idle_min` minutes of
+ * rest turn the agent face into the clock. Rest is all of these at once, timed from the last moment any of
+ * them failed: no finger and no touch, no voice, connected and loaded, and the face itself
+ * on the glass — never a list mid-swipe, a question, a draft, a form, a message, a stop or an update screen.
+ * A pane that is working does not hold the clock off (pb.2, owner's pick G2): the ring shows it working.
+ */
+static void pb_tick(uint32_t now)
+{
+    if (s.view == PBMENU && pb.count == -1 && (int32_t)(now - pb.deadline) >= 0) {
+        pb.count = -2;   // the Mac never answered pb.menu.open
+        change();
+    }
+    bool resting = pb.seen && pb.idle_min > 0 && (s.view == HOME || s.view == AGENT) && s.connected &&
+        !s.loading && !s.touch_down && !s.voice_open && !audio_client_active() &&
+        workspace.phase == HT_WORKSPACE_IDLE && !visit.pending && !selection.active && !carry.pending &&
+        !form.id[0] && !draft.page.active;
+    if (!resting) {
+        pb.rest_since = now;
+        return;
+    }
+    uint32_t idle = (uint32_t)pb.idle_min * 60000u;
+    if (now - pb.rest_since < idle || display_idle_ms() < idle) return;
+    ESP_LOGI("habitat", "rested %d min: clock", pb.idle_min);
+    view(CLOCK);
+    // The panel may have gone dark on its own idle timer first; the clock is what idle is for, so it comes
+    // back. A screen a person turned off (PWR, a held small button) stays off.
+    if (s.view == CLOCK && display_idle_slept()) display_wake();
+}
+// The cable went: the clock's words and the menu belonged to that connection, so neither stays up.
+static void pb_disconnected(void)
+{
+    pb.seen = false;
+    pb.count = -1;
+    pb.host = false;
+    // A running timer (and its alarm) belongs to the puck, not to the connection: it carries on (pb 3).
+    if (s.view == CLOCK || s.view == PBMENU || s.view == PICKER) view(HOME);
+}
+/*
+ * How long the panel stays on without a touch (display_habitat.c asks, under the lock, with its own 5 min).
+ * The clock holds it on — it is meant to be read across a room — and while the clock is armed the face waits
+ * long enough for the clock to take over rather than going dark a moment before. PWR and a held small
+ * button still turn it off; this is only the timer.
+ */
+uint32_t habitat_idle_off_ms(uint32_t normal)
+{
+    if (s.view == CLOCK || s.view == TIMER) return UINT32_MAX;
+    if (pb.seen && pb.idle_min > 0 && s.connected) {
+        uint32_t clock = (uint32_t)pb.idle_min * 60000u + 5000u;
+        if (clock > normal) return clock;
+    }
+    return normal;
+}
