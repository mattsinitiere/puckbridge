+/*
+ * PUCK BRIDGE'S LIGHT MODE (pb 6, owner 2026-10-14: "a full light mode too"): every colour the screens ask for goes
+ * through here, so one mapping turns the whole glass light. Greys flip (black ground -> soft white #f5f5f2, white
+ * text -> near black, a dark card -> a light grey one), and a colour keeps its hue but is darkened until it reads on
+ * white (the green, the orange, a PR's purple). The pets' own colours are baked RGB565 and never come through here.
+ */
+bool ht_light_theme;
+static unsigned light_rgb(unsigned c)
+{
+    int r = (c >> 16) & 255, g = (c >> 8) & 255, b = c & 255;
+    int hi = r > g ? (r > b ? r : b) : (g > b ? g : b), lo = r < g ? (r < b ? r : b) : (g < b ? g : b);
+    if (hi - lo < 48) {   // a grey (or nearly): flip it, black to #f5f5f2, white to #0a0a0a
+        r = 245 - r * 235 / 255; g = 245 - g * 235 / 255; b = 242 - b * 232 / 255;
+    } else {              // a colour: darker until its luma is at most 112 of 255
+        int y = (299 * r + 587 * g + 114 * b) / 1000;
+        if (y > 112) { r = r * 112 / y; g = g * 112 / y; b = b * 112 / y; }
+    }
+    return (unsigned)(r << 16 | g << 8 | b);
+}
