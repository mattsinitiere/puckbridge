+    s.hits[s.hit_count++] = (hit_t){{0, 0, HT_WIDTH, HT_HEIGHT}, A_HOME, 0, true};
+}
+// The small button held over a working pane: which pane, what stopping does, Cancel or Stop.
+static void render_pb_stop(ht_scene_t *f)
+{
+    focus_header(f, "STOP THIS TURN?");
+    int i = find(s.stop_agent);
+    focus_put(f, 50, 128, HT_WIDTH - 100, &ht_lv_inter_30.base, FG, BG, i >= 0 ? s.agents[i].name : "", true);
+    focus_put(f, 40, 196, HT_WIDTH - 80, &ht_lv_inter_25.base, color(0xada6ad), BG, "Your work stays.", true);
+    focus_put(f, 40, 230, HT_WIDTH - 80, &ht_lv_inter_25.base, color(0x6a6a76), BG, "Claude stops writing.", true);
+    pb_pill(f, 73, 306, 150, "Cancel", FG, A_HOME, true);
