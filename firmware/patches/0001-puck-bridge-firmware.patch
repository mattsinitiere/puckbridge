+    focus_header(f, title);
+    const ht_font_t *mid = &ht_lv_inter_25.base, *small = &ht_lv_inter_20.base;
+    pb_dots(f, PB_PAGE_SETTINGS, HT_WIDTH / 2, 432);
+    if (pb.count <= 0) {
+        focus_put(f, 40, 211, HT_WIDTH - 80, mid, DIM, BG,
+                  pb.count == -1 ? "Loading\xe2\x80\xa6" : pb.count == 0 ? "Nothing to set." :
+                  "No answer from the Mac.", true);
+        // The way out of a list with nothing in it (pb 4): the clock is one swipe left, as the dots say.
+        if (pb.count != -1)
+            focus_put(f, 40, 384, HT_WIDTH - 80, small, color(0x6a6a76), BG, "Swipe left for the clock", true);
+        return;
+    }
+    int last = pb.count > TAB_ROWS ? pb.count - TAB_ROWS : 0;
+    if (s.offset > last) s.offset = last;
+    if (s.offset < 0) s.offset = 0;
+    for (int row = 0; pb_nav() && row < TAB_ROWS && s.offset + row < pb.count && s.hit_count < 24; row++) {
+        /*
+         * PUCK BRIDGE'S SETTINGS AS CARDS (pb 5, owner: "make settings ui a lot better"): each row a rounded card,
+         * its name on the left in white, its value on the right in grey with a "›" when a picker is behind it, and an
+         * On/Off row drawn as a switch (green and knob right when on). Same rows, offsets and taps as before.
+         */
+        enum { X = 61, W = 344, H = 56 };
+        int i = s.offset + row, y = TAB_TOP + row * TAB_ROW_HEIGHT + (TAB_ROW_HEIGHT - H) / 2, hit = s.hit_count++;
+        s.hits[hit] = (hit_t){{LIST_HIT_X, y - 4, LIST_HIT_W, H + 8}, A_PBMENU_TAP, i, s.connected};
+        bool down = hit == s.pressed;
+        uint16_t fill = color(down ? 0x30333f : 0x16171c);
+        ht_box(f, X, y, W, H, H / 2, fill, color(0x2a2c33));
+        char label[PB_TEXT], value[PB_TEXT + 4];
+        pb_clean(label, sizeof label, pb.item[i].label[0] ? pb.item[i].label : pb.item[i].id, mid);
+        pb_clean(value, PB_TEXT, pb.item[i].value, mid);
+        bool on = !strcmp(value, "On"), toggle = !pb.item[i].choices && (on || !strcmp(value, "Off"));
+        int right = X + W - 22, vw = 0;
+        if (toggle) {
+            enum { SW = 50, SH = 30, KNOB = 24 };
+            int sx = right - SW, sy = y + (H - SH) / 2;
+            ht_box(f, sx, sy, SW, SH, SH / 2, color(on ? 0x30c75a : 0x3a3a42), color(on ? 0x30c75a : 0x3a3a42));
+            int kx = on ? sx + SW - KNOB - 3 : sx + 3;
+            ht_box(f, kx, sy + 3, KNOB, KNOB, KNOB / 2, color(on ? 0xffffff : 0xa8a8b0), color(on ? 0xffffff : 0xa8a8b0));
+            vw = SW;
+        } else {
+            if (pb.item[i].choices) strcat(value, " \xe2\x80\xba");   // " ›"
+            char fit[HT_TEXT_BYTES];
+            vw = ht_fit_width(fit, sizeof fit, value, 150, mid);
+            if (vw > 0) ht_text(f, right - vw, y + (H - mid->height) / 2, vw, mid,
+                                color(!s.connected ? HT_THEME_SECONDARY : down ? HT_THEME_VOICE : 0x9a9aa6), fill, fit);
+            else vw = 0;
+        }
+        char fit[HT_TEXT_BYTES];
+        int lw = ht_fit_width(fit, sizeof fit, label, right - vw - 14 - (X + 24), mid);
+        if (lw > 0) ht_text(f, X + 24, y + (H - mid->height) / 2, lw, mid, !s.connected ? DIM : FG, fill, fit);
+    }
+    for (int row = 0; !pb_nav() && row < TAB_ROWS && s.offset + row < pb.count && s.hit_count < 24; row++) {
+        int i = s.offset + row, y = TAB_TOP + row * TAB_ROW_HEIGHT, hit = s.hit_count++;
+        s.hits[hit] = (hit_t){{LIST_HIT_X, y, LIST_HIT_W, TAB_ROW_HEIGHT}, A_PBMENU_TAP, i, s.connected};
+        bool down = hit == s.pressed;
+        uint16_t ground = down ? SEL : BG;
+        if (down) ht_box(f, LIST_HIT_X, y + 2, LIST_HIT_W, TAB_ROW_HEIGHT - 4, 16, SEL, SEL);
+        char label[PB_TEXT], value[PB_TEXT + 4];
+        pb_clean(label, sizeof label, pb.item[i].label[0] ? pb.item[i].label : pb.item[i].id, small);
+        pb_clean(value, PB_TEXT, pb.item[i].value, mid);
+        if (pb.item[i].choices) strcat(value, " \xe2\x80\xba");   // a row with a picker behind it: " ›"
+        focus_put(f, LIST_HIT_X, y + 4, LIST_HIT_W, small, color(0x8a8a99), ground, label, true);
+        focus_put(f, LIST_HIT_X, y + 28, LIST_HIT_W, mid, !s.connected ? DIM : down ? ACCENT : FG, ground, value, true);
+    }
+    if (pb.count > TAB_ROWS) {   // where the window is, as the inbox's "1/2": a drag shows the rest
+        char where[32];
+        int end = s.offset + TAB_ROWS < pb.count ? s.offset + TAB_ROWS : pb.count;
+        snprintf(where, sizeof where, "%d\xe2\x80\x93%d of %d", s.offset + 1, end, pb.count);
+        focus_put(f, 40, pb_nav() ? 380 : 392, HT_WIDTH - 80, small, color(pb_nav() ? 0x585863 : 0x8a8a99), BG, where,
+                  true);
+    }
+    if (pb_nav() && s.offset == 0)   // pb 5: the way back is the way it came
+        focus_put(f, 60, 408, HT_WIDTH - 120, small, color(0x4c4c55), BG, "Swipe down to close", true);
+}
+/*
+ * PUCK BRIDGE'S PLAIN SCREENS (pb 4), in the clock's and the settings' type: a letter-spaced header, the words
+ * centred, a pill or two at the foot — not the terminal skin's "< title" and [bracket] controls.
+ */
+// ASCII capitals, printable ASCII only
+static void pb_upper(char *dst, size_t cap, const char *src)
+{
+    size_t n = 0;
+    for (const char *c = src ? src : ""; *c && n + 1 < cap; c++)
+        if (*c >= 0x20 && *c < 0x7f) dst[n++] = *c >= 'a' && *c <= 'z' ? (char)(*c - 'a' + 'A') : *c;
+    dst[cap ? n : 0] = 0;
+}
+// `text` wrapped to `w` and centred, at most `lines` lines centred on `mid_y`.
+static void pb_centred_text(ht_scene_t *f, int mid_y, int w, int lines, const ht_font_t *font, uint16_t ink,
+                            const char *text)
+{
+    int rows = focus_rows(text, font, w);
+    if (rows > lines) rows = lines;
+    int y = mid_y - rows * font->height / 2;
+    const char *p = text ? text : "";
+    for (int row = 0; row < rows && *p; row++) {
+        const char *start = p, *end = focus_take(&p, font, w);
+        char line[HT_TEXT_BYTES];
+        size_t n = (size_t)(end - start);
+        if (n >= sizeof line) n = sizeof line - 1;
+        memcpy(line, start, n);
+        line[n] = 0;
+        focus_put(f, (HT_WIDTH - w) / 2, y + row * font->height, w, font, ink, BG, line, true);
+    }
+}
+static void pb_pill(ht_scene_t *f, int x, int y, int w, const char *label, uint16_t ink, action_kind_t action,
+                    bool enabled)
+{
+    enum { H = 56 };
+    int hit = s.hit_count++;
+    s.hits[hit] = (hit_t){{x - 8, y - 10, w + 16, H + 24}, action, 0, enabled};
+    uint16_t fill = color(hit == s.pressed ? 0x30333f : 0x171718);
+    const ht_font_t *pf = &ht_lv_inter_28.base;
+    int tw = ht_measure(pf, label);
+    ht_box(f, x, y, w, H, H / 2, fill, color(0x3a3f4b));
+    ht_text(f, x + (w - tw) / 2, y + (H - pf->height) / 2, tw, pf, enabled ? ink : DIM, fill, label);
+}
+// Not connected yet, or the first list on its way: the name of the thing, and what it is waiting for.
+static void render_pb_wait(ht_scene_t *f)
+{
+    const ht_font_t *big = &ht_lv_inter_44.base, *mid = &ht_lv_inter_25.base;
+    focus_put(f, 40, 172, HT_WIDTH - 80, big, FG, BG, "Puck Bridge", true);
+    focus_put(f, 40, 236, HT_WIDTH - 80, mid, DIM, BG,
+              !s.connected ? "Open Puck Bridge on your Mac" : "Loading your chats\xe2\x80\xa6", true);
+    if (pbt.running) {   // a timer keeps running without the Mac
+        char left[16], line[HT_TEXT_BYTES];
+        pb_timer_text(left, sizeof left, pb_timer_left());
+        snprintf(line, sizeof line, "%s  %s", pbt.label[0] ? pbt.label : "Timer", left);
+        focus_put(f, 40, 292, HT_WIDTH - 80, mid, color(PB_INK_BUSY), BG, line, true);
+    }
+}
+// A message (a toast from the Mac, a voice turn that got no answer): a tap anywhere closes it.
+static void render_pb_message(ht_scene_t *f)
+{
+    char title[24];
