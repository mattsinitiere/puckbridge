# Puck Bridge firmware pb.7/pb.8: custom timers on the puck. A tap on the clock's weather line (a stopwatch beside it)
# opens the timer dial: preset chips (one tap starts one), hours/minutes/seconds (+ and -, or a drag up and down a
# column), Start. A running timer's dial is its countdown in a draining ring, with "+1 min" and Stop. The Mac's
# Custom… (pb.timerset) opens the dial set to its value. "<", a swipe right or the small button go back to the clock.
log 2
autoping 1
include demo/lib/welcome.sim
include demo/lib/lists_data.sim
include demo/lib/pbhost.sim
in {"t":"pb.ui","lists":"cards"}
time +300
boot tap
time +300
expect view CLOCK
time +4500
shot out/renders/timer_clock_idle.png
echo --- a tap on the weather line: the dial, at 5 min the first time
tap 233 262 120
time +200
expect view TIMERSET
shot out/renders/timer_dial.png
echo --- + on the hours, + + on the minutes, a drag up the seconds column
tap 136 163 100
tap 236 163 100
tap 236 163 100
swipe 336 300 336 140 600
time +200
shot out/renders/timer_dial_set.png
echo --- a drag that turned a column is not also a press
expect view TIMERSET
echo --- Start: 1 h 7 min 6 s (the drag's first px pick its axis), on the clock
mark
tap 233 376 120
time +200
expect view CLOCK
expect out {"t":"pb.timer.state","seconds":4026}
time +1200
shot out/renders/timer_clock_running.png
echo --- a tap on the timer's line: its countdown in a ring, +1 min and Stop
tap 233 262 120
time +200
expect view TIMERSET
shot out/renders/timer_dial_running.png
mark
tap 150 358 120
expect out {"t":"pb.timer.state","seconds":4085}
echo --- "<" goes back; the timer runs on
tap 30 233 100
time +200
expect view CLOCK
echo --- Stop cancels it
tap 233 262 120
time +200
mark
tap 316 358 120
time +200
expect view CLOCK
expect out {"t":"pb.timer.state","seconds":0}
echo --- a preset chip starts at once
tap 233 262 120
time +200
mark
tap 233 108 100
time +200
expect view CLOCK
expect out {"t":"pb.timer.state","seconds":900}
echo --- the Mac's Custom…: the dial (running: its ring), and from idle set to 2 h 15 min
in {"t":"pb.timer","seconds":0}
in {"t":"pb.timerset","seconds":8100}
time +200
expect view TIMERSET
shot out/renders/timer_dial_custom.png
mark
tap 233 376 120
expect out {"t":"pb.timer.state","seconds":8100}
expect view CLOCK
echo --- the small button leaves the dial too; a swipe right as well
tap 233 262 120
expect view TIMERSET
boot tap
expect view CLOCK
tap 233 262 120
swipe 120 233 330 233 250
time +200
expect view CLOCK
