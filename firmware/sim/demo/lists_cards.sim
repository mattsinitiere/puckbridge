# Puck Bridge firmware pb.5: the "cards" list style (pb.ui) on the panes list and the groups. Browsing switches
# nothing; a tap on a row opens that pane, a tap on a tab switches to it with the usual handshake.
log 3
autoping 1
include demo/lib/welcome.sim
include demo/lib/lists_data.sim
include demo/lib/pbhost.sim
in {"t":"pb.ui","lists":"cards"}
in {"t":"summary","agentId":"c3","name":"Grocery list","engine":"claude","machine":"Mac Studio","recap":"Added oat milk.","text":"Added oat milk."}
time +300
in {"t":"turn.started","agentId":"c2","text":"Writing…"}
time +20000
in {"t":"turn.started","agentId":"c2","text":"Writing…"}
time +14000
echo --- the face, then a swipe up: the panes list in the cards style
boot tap
tap 233 233
time +300
swipe 233 330 233 120 200
time +300
expect view AGENTS
shot out/renders/lists_cards_chats.png
echo --- browsing moves the list and opens nothing
mark
swipe 233 300 233 200 500
time +700
expect view AGENTS
expect noout {"t":"focus"
shot out/renders/lists_cards_chats_moved.png
echo --- a tap on the chosen row opens it (its face)
mark
tap 233 233 120
time +300
expect view AGENT
expect out {"t":"focus"
echo --- (pb.7: a hold on the face talks now) right twice: the list, then the groups, in the cards style
swipe 120 233 330 233 250
time +300
expect view AGENTS
swipe 120 233 330 233 250
time +300
expect view GROUPS
shot out/renders/lists_cards_tabs.png
echo --- browsing the groups switches nothing
mark
swipe 233 300 233 200 500
time +700
expect view GROUPS
expect noout swarm.select
shot out/renders/lists_cards_tabs_moved.png
echo --- a tap on the chosen group switches to it
mark
tap 233 233 120
time +200
expect out {"t":"swarm.select","swarmId":"code-b2"}
include demo/lib/lists_swarms_b2.sim
time +100
expect out {"t":"agents.refresh"}
in {"t":"agents.begin"}
in {"t":"agent","id":"cc-4","name":"Write the release notes","project":"openharness","engine":"claude","model":"","effort":"","machineId":"mac-1","machine":"Mac Studio"}
in {"t":"agents.end","total":1,"tab":"code-b2"}
in {"t":"focus","agentId":"cc-4","keepClock":true}
time +400
expect view AGENTS
echo --- classic again: the official pages come back
in {"t":"pb.ui","lists":"classic"}
tap 233 233 120
time +300
tap 233 233 800
time +300
expect view TABS
